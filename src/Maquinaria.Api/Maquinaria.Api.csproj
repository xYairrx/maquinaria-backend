<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>e2ab6bfa-6850-4b07-ba0b-06a9e777cd27</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- Requerido por las herramientas de EF: este es el proyecto de arranque y
         aqui vive FabricaContextoCentral. PrivateAssets=all para que no se publique. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Maquinaria.Infraestructura\Maquinaria.Infraestructura.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- La decision de que origenes acepta CORS es logica de seguridad y tiene que
         poder probarse. Se abre a las pruebas en lugar de volver publicos tipos que
         nadie fuera de la Api tiene por que ver. -->
    <InternalsVisibleTo Include="Maquinaria.Api.Tests" />
  </ItemGroup>

</Project>
