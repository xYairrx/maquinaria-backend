<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.AspNetCore.Cryptography.KeyDerivation" />
    <!-- Cache de la resolucion de tenants. Sin esto, cada peticion costaria tres
         consultas extra contra la base central. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <!-- Emite los JWT. La VALIDACION vive en Api, con JwtBearer. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Maquinaria.Aplicacion\Maquinaria.Aplicacion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Las consultas de EF se abren a las pruebas. Una proyeccion que no traduce a SQL no
         falla al compilar: falla en tiempo de ejecucion, la primera vez que alguien abre la
         pantalla. Comprobar que traduce es lo unico que se puede hacer sin base de datos, y
         para eso hace falta llegar a los repositorios, que son internal a proposito. -->
    <InternalsVisibleTo Include="Maquinaria.Api.Tests" />
  </ItemGroup>

</Project>
