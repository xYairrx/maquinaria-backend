<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.AspNetCore.Cryptography.KeyDerivation" />
    <!-- Cache de la resolucion de tenants. Sin esto, cada peticion costaria tres
         consultas extra contra la base central. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <!-- Emite los JWT. La VALIDACION vive en Api, con JwtBearer. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Maquinaria.Aplicacion\Maquinaria.Aplicacion.csproj" />
  </ItemGroup>

</Project>
